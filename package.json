{
  "name": "fullstack-boilerplate",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "start:api": "npm run start --workspace=apps/api",
    "start:web": "npm run start --workspace=apps/web",
    "start:dev:api": "npm run start:dev --workspace=apps/api",
    "start:dev:web": "npm run start:dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint:fix:web": "npm run lint:fix --workspace=apps/web",
    "format:web": "npm run prettier:format --workspace=apps/web",
    "test:unit:api": "npm run test:unit --workspace=apps/api",
    "test:integration:api": "npm run test:integration --workspace=apps/api",
    "test:all:api": "npm run test:all --workspace=apps/api",
    "test:web": "npm run test --workspace=apps/web",
    "test:coverage:web": "npm run test:coverage --workspace=apps/web",
    "lint:api": "npm run lint --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "lint:fix:api": "npm run lint:fix --workspace=apps/api",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,js}": [
      "eslint --fix",
      "bash -c 'cd apps/api && NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --findRelatedTests --passWithNoTests --testPathPatterns=\"\\.spec\\.ts$\" -- \"$@\"' --"
    ],
    "apps/web/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "bash -c 'cd apps/web && npx vitest run --reporter=verbose --passWithNoTests' --"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "3.8.3",
    "prisma": "^7.8.0"
  }
}